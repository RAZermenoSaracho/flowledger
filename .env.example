DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowledger?schema=public"

JWT_SECRET="replace-with-a-long-random-local-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"
REFRESH_TOKEN_COOKIE_DOMAIN=".razs.dev"

API_PORT="4000"
WEB_PORT="5173"

VITE_API_URL="http://localhost:4000"

NODE_ENV="development"

GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

WEB_APP_URL="http://localhost:5173"

SYNCFY_API_KEY="replace-with-syncfy-api-key"
SYNCFY_WEBHOOK_SIGNATURE_KEY="replace-with-syncfy-webhook-signature-key"
SYNCFY_API_BASE_URL="https://api.syncfy.com"
SYNCFY_DATA_BASE_URL="https://sync.paybook.com"
SYNCFY_WIDGET_SCRIPT_URL="https://cdn.skypack.dev/@paybook/sync-widget"
SYNCFY_WIDGET_STYLE_URL="https://cdn.jsdelivr.net/npm/@paybook/sync-widget/dist/widget.css"
SYNCFY_TRANSACTION_LOOKBACK_DAYS="60"
SYNCFY_AUTO_SYNC_ENABLED="true"
SYNCFY_AUTO_SYNC_INTERVAL_MINUTES="15"
SYNCFY_AUTO_SYNC_CONCURRENCY="3"
SYNCFY_AUTO_SYNC_JOB_TIMEOUT_MS="30000"