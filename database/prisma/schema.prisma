generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum AccountType {
  cash
  checking
  savings
  credit_card
  investment
  other
}

enum SharedExpenseStatus {
  open
  settled
  cancelled
}

enum ParticipantStatus {
  pending
  partial
  paid
}

enum SettlementStatus {
  pending
  approved
  rejected
}

enum HouseholdRole {
  admin
  member
}

model User {
  id                            String                     @id @default(cuid())
  name                          String
  email                         String                     @unique
  passwordHash                  String
  avatarUrl                     String?
  planType                      String                     @default("free")
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  accounts                      Account[]
  categories                    Category[]
  transactions                  Transaction[]
  ownedSharedExpenses           SharedExpense[]            @relation("OwnedSharedExpenses")
  sharedExpenseParticipations   SharedExpenseParticipant[]
  settlementRequestsMade        SettlementRequest[]        @relation("SettlementDebtor")
  settlementRequestsReceived    SettlementRequest[]        @relation("SettlementCreditor")
  householdMemberships          HouseholdMember[]
  ownedHouseholds               Household[]                @relation("OwnedHouseholds")
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         AccountType
  identifier   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String?
  householdId  String?
  name         String
  type         CategoryType
  color        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  household    Household?    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TransactionCategory")
  householdTransactions Transaction[] @relation("TransactionHouseholdCategory")

  @@index([userId])
  @@index([householdId])
}

model Transaction {
  id                    String                @id @default(cuid())
  userId                String
  name                  String
  amount                Decimal               @db.Decimal(12, 2)
  type                  TransactionType
  date                  DateTime
  categoryId            String?
  householdId           String?
  householdCategoryId   String?
  accountId             String?
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category?             @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  household             Household?            @relation(fields: [householdId], references: [id], onDelete: SetNull)
  householdCategory     Category?             @relation("TransactionHouseholdCategory", fields: [householdCategoryId], references: [id], onDelete: SetNull)
  account               Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  relations             TransactionRelation[] @relation("TransactionRelations")
  relatedBy             TransactionRelation[] @relation("RelatedTransactionRelations")
  sharedExpense         SharedExpense?

  @@index([userId, date])
  @@index([categoryId])
  @@index([householdId])
  @@index([householdCategoryId])
  @@index([accountId])
}

model Household {
  id             String              @id @default(cuid())
  name           String
  description    String?
  ownerUserId    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  owner          User                @relation("OwnedHouseholds", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members        HouseholdMember[]
  categories     Category[]
  transactions   Transaction[]

  @@index([ownerUserId])
}

model HouseholdMember {
  id             String         @id @default(cuid())
  householdId    String
  userId         String
  role           HouseholdRole  @default(member)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  household      Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model TransactionRelation {
  id                   String      @id @default(cuid())
  transactionId         String
  relatedTransactionId  String
  relationType          String
  createdAt             DateTime    @default(now())
  transaction           Transaction @relation("TransactionRelations", fields: [transactionId], references: [id], onDelete: Cascade)
  relatedTransaction    Transaction @relation("RelatedTransactionRelations", fields: [relatedTransactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([relatedTransactionId])
}

model SharedExpense {
  id           String                     @id @default(cuid())
  transactionId String                    @unique
  ownerUserId  String
  title        String
  totalAmount  Decimal                    @db.Decimal(12, 2)
  status       SharedExpenseStatus        @default(open)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  transaction  Transaction                @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  owner        User                       @relation("OwnedSharedExpenses", fields: [ownerUserId], references: [id], onDelete: Cascade)
  participants SharedExpenseParticipant[]

  @@index([ownerUserId])
}

model SharedExpenseParticipant {
  id              String            @id @default(cuid())
  sharedExpenseId String
  userId          String?
  participantName String
  shareAmount     Decimal           @db.Decimal(12, 2)
  paidAmount      Decimal           @db.Decimal(12, 2) @default(0)
  status          ParticipantStatus  @default(pending)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sharedExpense   SharedExpense     @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  settlementRequests SettlementRequest[]

  @@index([sharedExpenseId])
  @@index([userId])
}

model SettlementRequest {
  id                         String                   @id @default(cuid())
  sharedExpenseParticipantId String
  debtorUserId               String
  creditorUserId             String
  amount                     Decimal                  @db.Decimal(12, 2)
  status                     SettlementStatus         @default(pending)
  note                       String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  approvedAt                 DateTime?
  sharedExpenseParticipant   SharedExpenseParticipant @relation(fields: [sharedExpenseParticipantId], references: [id], onDelete: Cascade)
  debtor                     User                     @relation("SettlementDebtor", fields: [debtorUserId], references: [id], onDelete: Cascade)
  creditor                   User                     @relation("SettlementCreditor", fields: [creditorUserId], references: [id], onDelete: Cascade)

  @@index([sharedExpenseParticipantId])
  @@index([debtorUserId])
  @@index([creditorUserId])
  @@index([status])
}
