generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum AccountType {
  cash
  checking
  savings
  credit_card
  investment
  other
}

enum SharedExpenseStatus {
  open
  settled
  cancelled
}

enum ParticipantStatus {
  pending
  partial
  paid
}

enum SettlementStatus {
  pending
  approved
  rejected
}

enum GroupRole {
  admin
  member
}

enum NotificationType {
  group_member_added
  shared_expense_added
  debt_owes_money
  debt_owed_money
  settlement_requested
  settlement_approved
  settlement_rejected
  settlement_payment_registration_needed
}

model User {
  id                          String                     @id @default(cuid())
  name                        String
  email                       String                     @unique
  passwordHash                String
  avatarUrl                   String?
  planType                    String                     @default("free")
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  accounts                    Account[]
  categoryMemberships         CategoryUser[]
  transactions                Transaction[]
  ownedSharedExpenses         SharedExpense[]            @relation("OwnedSharedExpenses")
  sharedExpenseParticipations SharedExpenseParticipant[]
  settlementRequestsMade      SettlementRequest[]        @relation("SettlementDebtor")
  settlementRequestsReceived  SettlementRequest[]        @relation("SettlementCreditor")
  groupMemberships            GroupMember[]
  ownedGroups                 Group[]                    @relation("OwnedGroups")
  notifications               Notification[]
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         AccountType
  identifier   String?
  isArchived   Boolean       @default(false)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, isArchived])
}

model Category {
  id                String         @id @default(cuid())
  groupId           String?
  name              String
  type              CategoryType
  color             String?
  isArchived        Boolean        @default(false)
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  group             Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  users             CategoryUser[]
  transactions      Transaction[]  @relation("TransactionCategory")
  groupTransactions Transaction[]  @relation("TransactionGroupCategory")

  @@index([groupId])
  @@index([groupId, isArchived])
}

model CategoryUser {
  id         String   @id @default(cuid())
  categoryId String
  userId     String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([categoryId, userId])
  @@index([userId])
}

model Transaction {
  id              String                @id @default(cuid())
  userId          String
  name            String
  amount          Decimal               @db.Decimal(12, 2)
  type            TransactionType
  date            DateTime
  categoryId      String?
  groupId         String?
  groupCategoryId String?
  accountId       String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?             @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  group           Group?                @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupCategory   Category?             @relation("TransactionGroupCategory", fields: [groupCategoryId], references: [id], onDelete: SetNull)
  account         Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  relations       TransactionRelation[] @relation("TransactionRelations")
  relatedBy       TransactionRelation[] @relation("RelatedTransactionRelations")
  sharedExpense   SharedExpense?

  @@index([userId, date])
  @@index([categoryId])
  @@index([groupId])
  @@index([groupCategoryId])
  @@index([accountId])
}

model Group {
  id           String        @id @default(cuid())
  name         String
  description  String?
  ownerUserId  String
  isArchived   Boolean       @default(false)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation("OwnedGroups", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  categories   Category[]
  transactions Transaction[]

  @@index([ownerUserId])
  @@index([ownerUserId, isArchived])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(member)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model TransactionRelation {
  id                   String      @id @default(cuid())
  transactionId        String
  relatedTransactionId String
  relationType         String
  createdAt            DateTime    @default(now())
  transaction          Transaction @relation("TransactionRelations", fields: [transactionId], references: [id], onDelete: Cascade)
  relatedTransaction   Transaction @relation("RelatedTransactionRelations", fields: [relatedTransactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([relatedTransactionId])
}

model SharedExpense {
  id            String                     @id @default(cuid())
  transactionId String                     @unique
  ownerUserId   String
  title         String
  totalAmount   Decimal                    @db.Decimal(12, 2)
  status        SharedExpenseStatus        @default(open)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  transaction   Transaction                @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  owner         User                       @relation("OwnedSharedExpenses", fields: [ownerUserId], references: [id], onDelete: Cascade)
  participants  SharedExpenseParticipant[]

  @@index([ownerUserId])
}

model SharedExpenseParticipant {
  id                 String              @id @default(cuid())
  sharedExpenseId    String
  userId             String?
  participantName    String
  shareAmount        Decimal             @db.Decimal(12, 2)
  paidAmount         Decimal             @default(0) @db.Decimal(12, 2)
  status             ParticipantStatus   @default(pending)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sharedExpense      SharedExpense       @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  settlementRequests SettlementRequest[]

  @@index([sharedExpenseId])
  @@index([userId])
}

model SettlementRequest {
  id                         String                   @id @default(cuid())
  sharedExpenseParticipantId String
  debtorUserId               String
  creditorUserId             String
  amount                     Decimal                  @db.Decimal(12, 2)
  status                     SettlementStatus         @default(pending)
  note                       String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  approvedAt                 DateTime?
  sharedExpenseParticipant   SharedExpenseParticipant @relation(fields: [sharedExpenseParticipantId], references: [id], onDelete: Cascade)
  debtor                     User                     @relation("SettlementDebtor", fields: [debtorUserId], references: [id], onDelete: Cascade)
  creditor                   User                     @relation("SettlementCreditor", fields: [creditorUserId], references: [id], onDelete: Cascade)

  @@index([sharedExpenseParticipantId])
  @@index([debtorUserId])
  @@index([creditorUserId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
}
