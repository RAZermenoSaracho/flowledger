generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum AccountType {
  cash
  checking
  savings
  credit_card
  investment
  other
}

enum SharedExpenseStatus {
  open
  settled
  cancelled
}

enum ParticipantStatus {
  pending
  partial
  paid
}

enum SettlementStatus {
  pending
  approved
  rejected
}

enum GroupRole {
  admin
  member
}

enum NotificationType {
  group_member_added
  shared_expense_added
  debt_owes_money
  debt_owed_money
  settlement_requested
  settlement_approved
  settlement_rejected
  settlement_payment_registration_needed
}

model User {
  id                           String                        @id @default(cuid())
  name                         String
  email                        String                        @unique
  passwordHash                 String?
  avatarUrl                    String?
  planType                     String                        @default("free")
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  authAccounts                 UserAuthAccount[]
  accounts                     Account[]
  categoryMemberships          CategoryUser[]
  transactions                 Transaction[]
  providerConnections          ProviderConnection[]
  providerAccounts             ProviderAccount[]
  providerImportedTransactions ProviderImportedTransaction[]
  providerWebhookEvents        ProviderWebhookEvent[]
  ownedSharedExpenses          SharedExpense[]               @relation("OwnedSharedExpenses")
  sharedExpenseParticipations  SharedExpenseParticipant[]
  settlementRequestsMade       SettlementRequest[]           @relation("SettlementDebtor")
  settlementRequestsReceived   SettlementRequest[]           @relation("SettlementCreditor")
  groupMemberships             GroupMember[]
  ownedGroups                  Group[]                       @relation("OwnedGroups")
  notifications                Notification[]
}

model UserAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}

model Account {
  id                              String            @id @default(cuid())
  userId                          String
  name                            String
  type                            AccountType
  identifier                      String?
  initialBalance                  Decimal           @default(0) @db.Decimal(12, 2)
  isArchived                      Boolean           @default(false)
  archivedAt                      DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  user                            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions                    Transaction[]     @relation("TransactionAccount")
  transferDestinationTransactions Transaction[]     @relation("TransactionTransferToAccount")
  providerAccounts                ProviderAccount[]

  @@index([userId])
  @@index([userId, isArchived])
}

model Category {
  id                        String         @id @default(cuid())
  groupId                   String?
  name                      String
  type                      CategoryType
  color                     String?
  isArchived                Boolean        @default(false)
  archivedAt                DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  group                     Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  users                     CategoryUser[]
  transactions              Transaction[]  @relation("TransactionCategory")
  expenseOffsetTransactions Transaction[]  @relation("TransactionExpenseOffsetCategory")

  @@index([groupId])
  @@index([groupId, isArchived])
}

model CategoryUser {
  id         String   @id @default(cuid())
  categoryId String
  userId     String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([categoryId, userId])
  @@index([userId])
}

model Transaction {
  id                        String                @id @default(cuid())
  userId                    String
  name                      String
  amount                    Decimal               @db.Decimal(12, 2)
  type                      TransactionType
  date                      DateTime
  categoryId                String?
  expenseOffsetCategoryId   String?
  groupId                   String?
  accountId                 String?
  transferToAccountId       String?
  notes                     String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                  Category?             @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  expenseOffsetCategory     Category?             @relation("TransactionExpenseOffsetCategory", fields: [expenseOffsetCategoryId], references: [id], onDelete: SetNull)
  group                     Group?                @relation(fields: [groupId], references: [id], onDelete: SetNull)
  account                   Account?              @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  transferToAccount         Account?              @relation("TransactionTransferToAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  relations                 TransactionRelation[] @relation("TransactionRelations")
  relatedBy                 TransactionRelation[] @relation("RelatedTransactionRelations")
  sharedExpense             SharedExpense?
  debtorSettlementRequest   SettlementRequest?    @relation("SettlementDebtorTransaction")
  creditorSettlementRequest SettlementRequest?    @relation("SettlementCreditorTransaction")

  @@index([userId, date])
  @@index([categoryId])
  @@index([expenseOffsetCategoryId])
  @@index([groupId])
  @@index([accountId])
  @@index([transferToAccountId])
}

model Group {
  id           String        @id @default(cuid())
  name         String
  description  String?
  ownerUserId  String
  isArchived   Boolean       @default(false)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation("OwnedGroups", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  categories   Category[]
  transactions Transaction[]

  @@index([ownerUserId])
  @@index([ownerUserId, isArchived])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(member)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model TransactionRelation {
  id                   String      @id @default(cuid())
  transactionId        String
  relatedTransactionId String
  relationType         String
  createdAt            DateTime    @default(now())
  transaction          Transaction @relation("TransactionRelations", fields: [transactionId], references: [id], onDelete: Cascade)
  relatedTransaction   Transaction @relation("RelatedTransactionRelations", fields: [relatedTransactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([relatedTransactionId])
}

model SharedExpense {
  id            String                     @id @default(cuid())
  transactionId String                     @unique
  ownerUserId   String
  title         String
  totalAmount   Decimal                    @db.Decimal(12, 2)
  status        SharedExpenseStatus        @default(open)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  transaction   Transaction                @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  owner         User                       @relation("OwnedSharedExpenses", fields: [ownerUserId], references: [id], onDelete: Cascade)
  participants  SharedExpenseParticipant[]

  @@index([ownerUserId])
}

model SharedExpenseParticipant {
  id                 String              @id @default(cuid())
  sharedExpenseId    String
  userId             String?
  participantName    String
  shareAmount        Decimal             @db.Decimal(12, 2)
  paidAmount         Decimal             @default(0) @db.Decimal(12, 2)
  status             ParticipantStatus   @default(pending)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sharedExpense      SharedExpense       @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  settlementRequests SettlementRequest[]

  @@index([sharedExpenseId])
  @@index([userId])
}

model SettlementRequest {
  id                         String                   @id @default(cuid())
  sharedExpenseParticipantId String
  debtorUserId               String
  creditorUserId             String
  amount                     Decimal                  @db.Decimal(12, 2)
  status                     SettlementStatus         @default(pending)
  note                       String?
  paymentInfo                String?
  debtorAccountId            String?
  debtorCategoryId           String?
  creditorAccountId          String?
  creditorCategoryId         String?
  debtorTransactionId        String?                  @unique
  creditorTransactionId      String?                  @unique
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  approvedAt                 DateTime?
  sharedExpenseParticipant   SharedExpenseParticipant @relation(fields: [sharedExpenseParticipantId], references: [id], onDelete: Cascade)
  debtor                     User                     @relation("SettlementDebtor", fields: [debtorUserId], references: [id], onDelete: Cascade)
  creditor                   User                     @relation("SettlementCreditor", fields: [creditorUserId], references: [id], onDelete: Cascade)
  debtorTransaction          Transaction?             @relation("SettlementDebtorTransaction", fields: [debtorTransactionId], references: [id], onDelete: SetNull)
  creditorTransaction        Transaction?             @relation("SettlementCreditorTransaction", fields: [creditorTransactionId], references: [id], onDelete: SetNull)

  @@index([sharedExpenseParticipantId])
  @@index([debtorUserId])
  @@index([creditorUserId])
  @@index([debtorAccountId])
  @@index([debtorCategoryId])
  @@index([creditorAccountId])
  @@index([creditorCategoryId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
}

model ProviderConnection {
  id                   String                        @id @default(cuid())
  userId               String
  provider             String
  providerUserId       String?
  providerCredentialId String
  institutionId        String?
  institutionName      String?
  institutionMetadata  Json?
  status               String                        @default("active")
  lastSyncAt           DateTime?
  rawData              Json?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts             ProviderAccount[]
  importedTransactions ProviderImportedTransaction[]

  @@unique([provider, providerCredentialId])
  @@index([userId])
  @@index([provider, providerUserId])
  @@index([provider, status])
}

model ProviderAccount {
  id                   String                        @id @default(cuid())
  userId               String
  connectionId         String?
  accountId            String?
  provider             String
  providerUserId       String?
  providerCredentialId String
  providerAccountId    String
  institutionMetadata  Json?
  accountMetadata      Json?
  status               String                        @default("active")
  lastSyncAt           DateTime?
  rawData              Json?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection           ProviderConnection?           @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  account              Account?                      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  importedTransactions ProviderImportedTransaction[]

  @@unique([provider, providerCredentialId, providerAccountId])
  @@index([userId])
  @@index([connectionId])
  @@index([accountId])
  @@index([provider, providerUserId])
  @@index([provider, status])
}

model ProviderImportedTransaction {
  id                    String              @id @default(cuid())
  userId                String?
  connectionId          String?
  providerAccountRefId  String?
  provider              String
  providerUserId        String?
  providerCredentialId  String
  providerAccountId     String
  providerTransactionId String
  description           String
  amount                Decimal             @db.Decimal(12, 2)
  currency              String
  transactionDate       DateTime
  refreshDate           DateTime?
  status                String              @default("imported")
  errorMessage          String?
  rawData               Json
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  connection            ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  providerAccount       ProviderAccount?    @relation(fields: [providerAccountRefId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId])
  @@index([userId])
  @@index([connectionId])
  @@index([providerAccountRefId])
  @@index([provider, providerCredentialId])
  @@index([provider, providerAccountId])
  @@index([transactionDate])
  @@index([refreshDate])
  @@index([status])
}

model ProviderWebhookEvent {
  id                   String    @id @default(cuid())
  userId               String?
  provider             String
  providerUserId       String?
  providerExternalId   String?
  providerCredentialId String?
  providerEventId      String
  rid                  String?
  eventName            String
  rawPayload           Json
  rawHeaders           Json
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?
  status               String    @default("received")
  errorMessage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([userId])
  @@index([provider, providerUserId])
  @@index([provider, providerExternalId])
  @@index([provider, providerCredentialId])
  @@index([provider, status])
  @@index([receivedAt])
}
